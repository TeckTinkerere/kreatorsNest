# KreatorNest build configuration

# Public origin of the deployed site, e.g. https://kreatornest.com
# Required for SEO: without it, sitemap.xml is not generated and build-time
# prerendering is skipped (it would bake localhost canonical URLs into
# every page). See docs/SEO-AND-GEO.md.
REACT_APP_SITE_URL=

# Google Sheets ID holding the editable site content.
# Copy it out of the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
# Leave blank to run entirely on the bundled data in src/data/.
REACT_APP_CONTENT_SHEET_ID=

# Umami analytics website id, from cloud.umami.is after adding the site.
# Leave blank to disable analytics entirely — no script is loaded.
REACT_APP_UMAMI_WEBSITE_ID=

# Only needed when self-hosting Umami instead of using Umami Cloud.
# REACT_APP_UMAMI_SCRIPT_URL=https://your-umami-instance.example/script.js

# Google Form URL for resource suggestions from peers.
# Leave blank to hide every "Add a resource" entry point.
# See docs/CONTRIBUTING-PEERS.md.
REACT_APP_SUGGEST_FORM_URL=
